# Copy to .env and adjust. Every setting is optional; defaults run locally
# against the deterministic stub backend with no GPU.

# --- inference -------------------------------------------------------------
# "stub" runs a deterministic local implementation (no GPU, used by the tests).
# "openai" targets any OpenAI-compatible server, which is what vLLM and SGLang
# both expose.
RESCAN_LLM_BACKEND=stub
RESCAN_LLM_BASE_URL=http://localhost:8000/v1
RESCAN_LLM_MODEL=Qwen/Qwen3.8-27B
RESCAN_LLM_API_KEY=not-needed
RESCAN_LLM_MAX_CONCURRENCY=16

# Ensemble members for the borderline pass. Comma-separated. When empty, the
# single configured model is used with three different seeds.
# RESCAN_ENSEMBLE_MODELS=model-a,model-b,model-c

# --- object store ----------------------------------------------------------
# Where a job's resumes are pulled from: objects under <prefix>/<jobId>/.
# "local" reads the same layout from data/bucket/ (development, tests).
# "s3" is any S3-compatible endpoint: MinIO, Cloudflare R2, AWS.
RESCAN_OBJECT_STORE=local
# RESCAN_S3_ENDPOINT_URL=http://localhost:9000   # omit for AWS
# RESCAN_S3_BUCKET=resumes
# RESCAN_S3_ACCESS_KEY_ID=minioadmin
# RESCAN_S3_SECRET_ACCESS_KEY=minioadmin
# RESCAN_S3_REGION=auto
RESCAN_S3_PREFIX=jobs

# --- extraction ------------------------------------------------------------
RESCAN_TIKA_URL=http://localhost:9998
RESCAN_EXTRACT_WORKERS=8
RESCAN_OCR_ENABLED=true

# --- ranking ---------------------------------------------------------------
RESCAN_SHORTLIST_SIZE=10
RESCAN_BORDERLINE_MARGIN=0.08

# --- auth ------------------------------------------------------------------
# Comma-separated. EMPTY MEANS NO AUTHENTICATION — set this before exposing
# the API beyond localhost.
RESCAN_API_KEYS=
